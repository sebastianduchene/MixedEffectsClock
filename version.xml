<package name='MixedEffectsClock' version='0.0.1'>
  <depends on='BEAST.base' atleast='2.7.7'/>

  <!-- BEAST 2.7 will not load a class that is not registered here. The failure
       mode is "Could not find class X as service beast.base.core.BEASTInterface",
       which reads like a missing package rather than a missing registration.
       Every new public class must be added below. -->
  <service type="beast.base.core.BEASTInterface">
    <provider classname="mixedeffectsclock.MixedEffectsClockModel"/>
    <provider classname="mixedeffectsclock.CladeDesign"/>
    <provider classname="mixedeffectsclock.DesignLogger"/>
  </service>
</package>
