<!--
  The same topology test, but with the clades CONSTRAINED to be monophyletic.

  topology_rate_map_6taxon.xml showed what goes wrong without constraints: the clades
  break up, a clade's ancestor swallows unrelated branches, columns start to overlap and
  a branch inside two columns carries the SUM of their coefficients. In the later samples
  of that run nearly every branch had collapsed into one combined class, so the design no
  longer says what it was meant to say.

  That is not a defect in the clock. It is what a taxon-set-defined clade MEANS when the
  taxa are not monophyletic: the most recent common ancestor subsumes everything between
  them. The fix is to constrain the clades, which is exactly what the BEAST X production
  analysis does with booleanLikelihood over monophylyStatistic. Here that is an MRCAPrior
  with monophyletic="true" on each clade, referencing the clock's own TaxonSet by idref so
  the constraint and the design can never disagree. The clock also logs a
  monophyletic.<clade> indicator per clade, and warns once at the first design build if a
  clade is already broken on the starting tree.

  With the constraints in place the branch counts must stay at 3, 2, 1 and 4 background
  for every sample, no matter how the topology moves, and nPainted.multiple must stay 0.
  The monophyly indicators are logged so a violated constraint would be visible.

  Constraining three disjoint pairs of a six-taxon tree leaves exactly three rooted
  topologies, and all three are visited across the 20 samples, so the topology space is
  covered completely.

  Run:  beast -overwrite -seed 3 topology_rate_map_6taxon_monophyletic.xml
-->
<beast namespace="beast.base.evolution.alignment:beast.base.evolution.tree:beast.base.inference:beast.base.inference.parameter"
       required="BEAST.base v2.7.7:MixedEffectsClock v0.0.1"
       version="2.7">

  <!-- Every sequence is entirely ambiguous, so this alignment carries no information
       at all. It exists for two reasons. It puts the clock inside the posterior,
       without which BEAST never invalidates the design cache. And a flat likelihood
       lets the coalescent and the tree moves decide the topology, instead of 200
       arbitrary random sites pinning it: with real random data all 20 samples came
       back with the SAME topology and the test only varied node heights. -->
  <data id="alignment" spec="beast.base.evolution.alignment.Alignment" name="alignment" dataType="nucleotide">
    <sequence spec="beast.base.evolution.alignment.Sequence" taxon="t1" totalcount="4" value="NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN"/>
    <sequence spec="beast.base.evolution.alignment.Sequence" taxon="t2" totalcount="4" value="NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN"/>
    <sequence spec="beast.base.evolution.alignment.Sequence" taxon="t3" totalcount="4" value="NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN"/>
    <sequence spec="beast.base.evolution.alignment.Sequence" taxon="t4" totalcount="4" value="NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN"/>
    <sequence spec="beast.base.evolution.alignment.Sequence" taxon="t5" totalcount="4" value="NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN"/>
    <sequence spec="beast.base.evolution.alignment.Sequence" taxon="t6" totalcount="4" value="NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN"/>
  </data>

  <run id="mcmc" spec="beast.base.inference.MCMC" chainLength="190000">

    <state id="state" spec="beast.base.inference.State">
      <tree id="Tree" spec="beast.base.evolution.tree.Tree" name="stateNode">
        <taxonset id="TaxonSet" spec="beast.base.evolution.alignment.TaxonSet">
          <taxon id="t1" spec="beast.base.evolution.alignment.Taxon"/>
          <taxon id="t2" spec="beast.base.evolution.alignment.Taxon"/>
          <taxon id="t3" spec="beast.base.evolution.alignment.Taxon"/>
          <taxon id="t4" spec="beast.base.evolution.alignment.Taxon"/>
          <taxon id="t5" spec="beast.base.evolution.alignment.Taxon"/>
          <taxon id="t6" spec="beast.base.evolution.alignment.Taxon"/>
        </taxonset>
      </tree>
      <parameter id="coefficient" spec="beast.base.inference.parameter.RealParameter" dimension="3" name="stateNode">1.3862943611198906 -1.6094379124341003 2.302585092994046</parameter>
      <parameter id="rates"       spec="beast.base.inference.parameter.RealParameter" dimension="10" lower="0.0" name="stateNode">1.0</parameter>
      <parameter id="ucldStdev"   spec="beast.base.inference.parameter.RealParameter" lower="0.0" name="stateNode">0.3</parameter>
      <parameter id="clockRate"   spec="beast.base.inference.parameter.RealParameter" lower="0.0" name="stateNode">2.0E-3</parameter>
    </state>

    <init id="startingTree" spec="beast.base.evolution.tree.TreeParser"
          initial="@Tree" taxonset="@TaxonSet" IsLabelledNewick="true" adjustTipHeights="false"
          newick="(((t1:1,t2:1):1,(t3:1,t4:1):1):1,(t5:2,t6:2):1):0.0;"/>

    <distribution id="posterior" spec="beast.base.inference.CompoundDistribution">
      <distribution id="coefficientPrior" spec="beast.base.inference.distribution.Prior" x="@coefficient">
        <distr spec="beast.base.inference.distribution.Normal">
          <parameter spec="beast.base.inference.parameter.RealParameter" estimate="false" name="mean">0.0</parameter>
          <parameter spec="beast.base.inference.parameter.RealParameter" estimate="false" name="sigma">2.0</parameter>
        </distr>
      </distribution>
      <!-- A constant-size coalescent, so the tree stays finite. Without any tree
           prior the root scaler drifts upward without bound: on 200 saturated
           random sites the likelihood is flat once branches are long, and node ages
           reach 1e308 within 20,000 states. A short chain merely hides this.
           popSize is fixed, so the tree still has the only operators. -->
      <distribution id="coalescent" spec="beast.base.evolution.tree.coalescent.Coalescent">
        <treeIntervals id="TreeIntervals" spec="beast.base.evolution.tree.TreeIntervals" tree="@Tree"/>
        <populationModel id="constant" spec="beast.base.evolution.tree.coalescent.ConstantPopulation">
          <parameter spec="beast.base.inference.parameter.RealParameter" estimate="false" name="popSize">1.0</parameter>
        </populationModel>
      </distribution>
      <distribution id="likelihood" spec="beast.base.evolution.likelihood.TreeLikelihood" data="@alignment" tree="@Tree">
        <siteModel id="siteModel" spec="beast.base.evolution.sitemodel.SiteModel">
          <substModel id="jc" spec="beast.base.evolution.substitutionmodel.JukesCantor"/>
        </siteModel>
          <branchRateModel id="clock" spec="mixedeffectsclock.MixedEffectsClockModel"
                 tree="@Tree" rates="@rates" clock.rate="@clockRate" coefficient="@coefficient">
            <distr id="rateDistr" spec="beast.base.inference.distribution.LogNormalDistributionModel"
                   S="@ucldStdev" meanInRealSpace="true">
              <parameter spec="beast.base.inference.parameter.RealParameter" estimate="false" name="M">1.0</parameter>
            </distr>

            <clade id="cladeA" spec="mixedeffectsclock.CladeDesign" category="0" includeStem="true">
              <taxonset id="taxa.A" spec="beast.base.evolution.alignment.TaxonSet">
                <taxon idref="t1"/>
                <taxon idref="t2"/>
              </taxonset>
            </clade>

            <clade id="cladeB" spec="mixedeffectsclock.CladeDesign" category="1" includeStem="false">
              <taxonset id="taxa.B" spec="beast.base.evolution.alignment.TaxonSet">
                <taxon idref="t3"/>
                <taxon idref="t4"/>
              </taxonset>
            </clade>

            <clade id="cladeC" spec="mixedeffectsclock.CladeDesign" category="2" includeStem="true" excludeClade="true">
              <taxonset id="taxa.C" spec="beast.base.evolution.alignment.TaxonSet">
                <taxon idref="t5"/>
                <taxon idref="t6"/>
              </taxonset>
            </clade>
          </branchRateModel>
      </distribution>

      <!-- Monophyly is enforced on the SAME TaxonSet objects the clock's clade
           elements use, referenced by idref rather than redeclared. Two separate
           copies of the taxa would let the constraint and the design drift apart:
           editing a clade would leave the constraint guarding a set the design no
           longer uses, and nothing would complain. These sit after the likelihood
           because that is where the ids are defined, and BEAST resolves idrefs in
           document order. -->
      <distribution id="monophyly.cladeA" spec="beast.base.evolution.tree.MRCAPrior" monophyletic="true" tree="@Tree">
        <taxonset idref="taxa.A"/>
      </distribution>
      <distribution id="monophyly.cladeB" spec="beast.base.evolution.tree.MRCAPrior" monophyletic="true" tree="@Tree">
        <taxonset idref="taxa.B"/>
      </distribution>
      <distribution id="monophyly.cladeC" spec="beast.base.evolution.tree.MRCAPrior" monophyletic="true" tree="@Tree">
        <taxonset idref="taxa.C"/>
      </distribution>
    </distribution>


    <!-- BEAUti's standard tree move set, and nothing else. The intercept, the three
         coefficients, the branch multipliers and the dispersion all stay fixed, so any
         change in a branch rate can only come from the design being remapped. -->
    <operator id="treeRootScaler" spec="beast.base.evolution.operator.kernel.BactrianScaleOperator" tree="@Tree" rootOnly="true" scaleFactor="0.1" upper="10.0" weight="3.0"/>
    <operator id="uniformHeights" spec="beast.base.evolution.operator.kernel.BactrianNodeOperator" tree="@Tree" weight="30.0"/>
    <operator id="subtreeSlide"   spec="beast.base.evolution.operator.kernel.BactrianSubtreeSlide" tree="@Tree" weight="15.0"/>
    <operator id="narrowExchange" spec="beast.base.evolution.operator.Exchange" tree="@Tree" weight="15.0"/>
    <operator id="wideExchange"   spec="beast.base.evolution.operator.Exchange" tree="@Tree" isNarrow="false" weight="3.0"/>
    <operator id="wilsonBalding"  spec="beast.base.evolution.operator.WilsonBalding" tree="@Tree" weight="3.0"/>

    <logger id="tracelog" spec="beast.base.inference.Logger" fileName="$(filebase).log" logEvery="10000">
      <log idref="posterior"/>
      <log idref="monophyly.cladeA"/>
      <log idref="monophyly.cladeB"/>
      <log idref="monophyly.cladeC"/>
      <log id="designLog" spec="mixedeffectsclock.DesignLogger" validate="true" clock="@clock"/>
    </logger>
    <logger id="treelog" spec="beast.base.inference.Logger" fileName="$(filebase).trees" logEvery="10000" mode="tree">
      <log id="treeWithRates" spec="beast.base.evolution.TreeWithMetaDataLogger" tree="@Tree" branchratemodel="@clock"/>
    </logger>
  </run>
</beast>
